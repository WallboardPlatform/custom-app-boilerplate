{
	"version": "1",
	"name": "Veszprem Downtown Wayfinding",
	"interactive": true,
	"size": {
		"width": "1920px",
		"height": "1080px"
	},
	"properties": [
		{
			"label": "Destination datasource",
			"type": "dataPicker",
			"property": "destinationData",
			"dataPickerType": "any",
			"tooltip": "Select the Veszprem Downtown Wayfinding Destinations table. Leave unbound to use the packaged public landmark names from the supplied map."
		},
		{
			"label": "Kiosk content",
			"type": "group",
			"properties": [
				{ "label": "Title", "type": "text", "property": "title", "default": "Veszprem Downtown Wayfinding" },
				{ "label": "Instruction", "type": "text", "property": "subtitle", "default": "Choose a landmark or tap its number on the map." },
				{
					"label": "Guidance mode", "type": "select", "property": "guidanceMode", "default": "highlight",
					"tooltip": "Highlight is the honest default for this illustrated map. Directional requires venue-confirmed map orientation and never claims a walkable route.",
					"options": [
						{ "label": "Highlight destination", "value": "highlight" },
						{ "label": "Direction from kiosk", "value": "directional" },
						{ "label": "Directory only", "value": "directory" }
					]
				},
				{
					"label": "Interface languages", "type": "select", "property": "interfaceLanguages", "default": "en-hu",
					"options": [
						{ "label": "English + Hungarian", "value": "en-hu" },
						{ "label": "English", "value": "en" },
						{ "label": "Hungarian", "value": "hu" }
					]
				},
				{
					"label": "Start location", "type": "select", "property": "startLocationId", "default": "tourinform-veszprem",
					"tooltip": "Choose the kiosk's physical map position.",
					"options": [
						{ "label": "Tourist Information Centre", "value": "tourinform-veszprem" },
						{ "label": "Heroes' Gate", "value": "hosok-kapuja" },
						{ "label": "Modern Art Gallery", "value": "modern-keptar-vass-gyujtemeny" },
						{ "label": "Fire Lookout Tower", "value": "tuztorony" },
						{ "label": "FOTON Audiovisual Centre", "value": "foton-audiovizualis-kozpont" },
						{ "label": "Csikász Gallery", "value": "csikasz-galeria" },
						{ "label": "Dubniczay Palace", "value": "dubniczay-palota" },
						{ "label": "Bíró-Giczey House", "value": "biro-giczey-haz" },
						{ "label": "St. Stephen's Church", "value": "szent-istvan-templom" },
						{ "label": "Körmendy House", "value": "kormendy-haz" },
						{ "label": "Statue of King St. Stephen and Queen Gizella", "value": "szent-istvan-es-gizella-szobor" },
						{ "label": "Benedict Hill", "value": "benedek-hegy" },
						{ "label": "St. George Chapel", "value": "szent-gyorgy-kapolna" },
						{ "label": "St. Michael's Basilica", "value": "szent-mihaly-foszekesegyhaz" },
						{ "label": "Holy Trinity Statue", "value": "szentharomsag-szobor" },
						{ "label": "Castle Well", "value": "varkut" },
						{ "label": "Gisela Chapel", "value": "gizella-kapolna" },
						{ "label": "Archbishop's Palace", "value": "erseki-palota" },
						{ "label": "Saint Emeric Church", "value": "szent-imre-templom" },
						{ "label": "Deák Ferenc Street Events Centre", "value": "deak-ferenc-rendezvenykozpont" },
						{ "label": "Auer House", "value": "auer-haz" },
						{ "label": "Pósa House", "value": "posa-haz" },
						{ "label": "Ruttner House - Castle Prison Exhibition", "value": "ruttner-haz-varborton" },
						{ "label": "CODE Digital Experience Centre", "value": "code-digitalis-elmenykozpont" },
						{ "label": "Petőfi Theatre of Veszprém", "value": "petofi-szinhaz" },
						{ "label": "Hangvilla Cultural Centre", "value": "hangvilla" },
						{ "label": "Eötvös Károly County Library", "value": "eotvos-karoly-megyei-konyvtar" },
						{ "label": "Ruins of Saint Nicholas Church", "value": "szent-miklos-szeg" },
						{ "label": "Laczkó Dezső Museum", "value": "laczko-dezso-muzeum" },
						{ "label": "Bakony House", "value": "bakonyi-haz" },
						{ "label": "University Sports Courts", "value": "egyetemi-rekortan-sportpalyak" },
						{ "label": "ActiCity Dance and Movement Centre", "value": "acticity" },
						{ "label": "Digital Knowledge Centre", "value": "digitalis-tudaskozpont" },
						{ "label": "Gyárkert Culture Park", "value": "gyarkert-kulturpark" }
					]
				},
				{ "label": "Empty state", "type": "text", "property": "emptyStateText", "default": "No destinations are available." },
				{ "label": "On-screen keyboard", "type": "checkbox", "property": "onScreenKeyboard", "default": true, "tooltip": "Opens an app-owned touch keyboard when destination search receives focus." },
				{
					"label": "Keyboard languages", "type": "select", "property": "keyboardLanguages", "default": "hu-en",
					"options": [
						{ "label": "Hungarian + English", "value": "hu-en" },
						{ "label": "Hungarian", "value": "hu" },
						{ "label": "English", "value": "en" }
					],
					"visibilityConditions": { "conditions": [{ "id": "#1", "type": "EQUALS", "value": true, "dependsOn": "onScreenKeyboard" }], "rule": "#1" }
				},
				{ "label": "Selection reset", "type": "slider", "property": "routeResetSeconds", "default": 45, "min": 10, "max": 180, "step": 5, "tooltip": "Seconds before the active destination and search clear automatically." },
				{
					"label": "Orientation verified by venue", "type": "checkbox", "property": "orientationConfirmed", "default": false,
					"tooltip": "Enable only after a venue reviewer confirms the current-location anchor and map orientation.",
					"visibilityConditions": { "conditions": [{ "id": "#1", "type": "EQUALS", "value": "directional", "dependsOn": "guidanceMode" }], "rule": "#1" }
				},
				{
					"label": "Map north offset", "type": "slider", "property": "mapNorthOffsetDegrees", "default": 0, "min": 0, "max": 359, "step": 1,
					"tooltip": "Venue-confirmed clockwise angle between screen-up and north on the supplied map.",
					"visibilityConditions": { "conditions": [{ "id": "#1", "type": "EQUALS", "value": "directional", "dependsOn": "guidanceMode" }], "rule": "#1" }
				}
			]
		},
		{
			"label": "Experience",
			"type": "group",
			"properties": [
				{
					"label": "Motion",
					"type": "select",
					"property": "motionPreset",
					"default": "subtle",
					"options": [
						{ "label": "Off", "value": "off" },
						{ "label": "Subtle", "value": "subtle" }
					]
				}
			]
		},
		{
			"label": "Appearance",
			"type": "group",
			"properties": [
				{
					"label": "Color scheme",
					"type": "select",
					"property": "themePreset",
					"default": "light",
					"tooltip": "Light and Dark are coordinated presets. Choose Custom to use the semantic color controls below.",
					"options": [
						{ "label": "Light", "value": "light" },
						{ "label": "Dark", "value": "dark" },
						{ "label": "Custom", "value": "custom" }
					]
				},
				{ "label": "Background", "type": "color", "property": "backgroundColor", "default": "#ead9c8", "visibilityConditions": { "conditions": [{ "id": "#1", "type": "EQUALS", "value": "custom", "dependsOn": "themePreset" }], "rule": "#1" } },
				{ "label": "Panel", "type": "color", "property": "panelColor", "default": "#fff9ef", "visibilityConditions": { "conditions": [{ "id": "#1", "type": "EQUALS", "value": "custom", "dependsOn": "themePreset" }], "rule": "#1" } },
				{ "label": "Primary text", "type": "color", "property": "primaryTextColor", "default": "#17312f", "visibilityConditions": { "conditions": [{ "id": "#1", "type": "EQUALS", "value": "custom", "dependsOn": "themePreset" }], "rule": "#1" } },
				{ "label": "Secondary text", "type": "color", "property": "secondaryTextColor", "default": "#5d716d", "visibilityConditions": { "conditions": [{ "id": "#1", "type": "EQUALS", "value": "custom", "dependsOn": "themePreset" }], "rule": "#1" } },
				{ "label": "Accent", "type": "color", "property": "accentColor", "default": "#d08b2e", "visibilityConditions": { "conditions": [{ "id": "#1", "type": "EQUALS", "value": "custom", "dependsOn": "themePreset" }], "rule": "#1" } },
				{ "label": "Destination highlight", "type": "color", "property": "routeColor", "default": "#cf332b", "visibilityConditions": { "conditions": [{ "id": "#1", "type": "EQUALS", "value": "custom", "dependsOn": "themePreset" }], "rule": "#1" } }
			]
		}
	],
	"resourceList": [
		"assets/app.js",
		"assets/app-chrome-49.js",
		"assets/index.webp"
	],
	"externalCommands": []
}
