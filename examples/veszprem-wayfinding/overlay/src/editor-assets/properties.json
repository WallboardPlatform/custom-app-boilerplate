{
	"version": "1",
	"name": "Veszprem Downtown Wayfinding",
	"interactive": true,
	"size": {
		"width": "1920px",
		"height": "1080px"
	},
	"properties": [
		{
			"label": "Destination datasource",
			"type": "dataPicker",
			"property": "destinationData",
			"dataPickerType": "any",
			"tooltip": "Select the Veszprem Downtown Wayfinding Destinations table. Leave unbound to use the packaged representative landmark metadata."
		},
		{
			"label": "Kiosk content",
			"type": "group",
			"properties": [
				{ "label": "Title", "type": "text", "property": "title", "default": "Veszprem Downtown Wayfinding" },
				{ "label": "Instruction", "type": "text", "property": "subtitle", "default": "Choose a destination to draw a walking route from Heroes' Gate." },
				{ "label": "Start location ID", "type": "text", "property": "startLocationId", "default": "hosok-kapuja", "tooltip": "Use an id from the destination table and SVG, for example hosok-kapuja." },
				{ "label": "Empty state", "type": "text", "property": "emptyStateText", "default": "No destinations are available." },
				{ "label": "On-screen keyboard", "type": "checkbox", "property": "onScreenKeyboard", "default": true, "tooltip": "Opens an app-owned touch keyboard when destination search receives focus." },
				{
					"label": "Keyboard languages", "type": "select", "property": "keyboardLanguages", "default": "hu-en",
					"options": [
						{ "label": "Hungarian + English", "value": "hu-en" },
						{ "label": "Hungarian", "value": "hu" },
						{ "label": "English", "value": "en" }
					],
					"visibilityConditions": { "conditions": [{ "id": "#1", "type": "EQUALS", "value": true, "dependsOn": "onScreenKeyboard" }], "rule": "#1" }
				},
				{ "label": "Route reset", "type": "slider", "property": "routeResetSeconds", "default": 45, "min": 10, "max": 180, "step": 5, "tooltip": "Seconds before an active route clears automatically." },
				{ "label": "Route sensitivity", "type": "slider", "property": "wayfindingSensitivity", "default": 50, "min": 10, "max": 100, "step": 1, "tooltip": "Maximum SVG distance used to connect neighboring route points." },
				{ "label": "Map ratio", "type": "slider", "property": "mapRatio", "default": 1, "min": 0.5, "max": 20, "step": 0.5, "tooltip": "SVG pixels per displayed meter for approximate distance and walking time." }
			]
		},
		{
			"label": "Appearance",
			"type": "group",
			"properties": [
				{
					"label": "Color scheme",
					"type": "select",
					"property": "themePreset",
					"default": "light",
					"tooltip": "Light and Dark are coordinated presets. Choose Custom to use the semantic color controls below.",
					"options": [
						{ "label": "Light", "value": "light" },
						{ "label": "Dark", "value": "dark" },
						{ "label": "Custom", "value": "custom" }
					]
				},
				{ "label": "Background", "type": "color", "property": "backgroundColor", "default": "#ead9c8", "visibilityConditions": { "conditions": [{ "id": "#1", "type": "EQUALS", "value": "custom", "dependsOn": "themePreset" }], "rule": "#1" } },
				{ "label": "Panel", "type": "color", "property": "panelColor", "default": "#fff9ef", "visibilityConditions": { "conditions": [{ "id": "#1", "type": "EQUALS", "value": "custom", "dependsOn": "themePreset" }], "rule": "#1" } },
				{ "label": "Primary text", "type": "color", "property": "primaryTextColor", "default": "#17312f", "visibilityConditions": { "conditions": [{ "id": "#1", "type": "EQUALS", "value": "custom", "dependsOn": "themePreset" }], "rule": "#1" } },
				{ "label": "Secondary text", "type": "color", "property": "secondaryTextColor", "default": "#5d716d", "visibilityConditions": { "conditions": [{ "id": "#1", "type": "EQUALS", "value": "custom", "dependsOn": "themePreset" }], "rule": "#1" } },
				{ "label": "Accent", "type": "color", "property": "accentColor", "default": "#d08b2e", "visibilityConditions": { "conditions": [{ "id": "#1", "type": "EQUALS", "value": "custom", "dependsOn": "themePreset" }], "rule": "#1" } },
				{ "label": "Route", "type": "color", "property": "routeColor", "default": "#cf332b", "visibilityConditions": { "conditions": [{ "id": "#1", "type": "EQUALS", "value": "custom", "dependsOn": "themePreset" }], "rule": "#1" } }
			]
		}
	],
	"resourceList": [
		"assets/app.js",
		"assets/app-chrome-49.js"
	],
	"externalCommands": []
}
