{
	"version": "1",
	"name": "Donor Directory",
	"interactive": true,
	"size": {
		"width": "1920px",
		"height": "1080px"
	},
	"properties": [
		{
			"label": "Donor datasource",
			"type": "dataPicker",
			"property": "donorData",
			"dataPickerType": "any",
			"tooltip": "Bind the internal TABLE that contains the donor records."
		},
		{
			"label": "Category metadata datasource",
			"type": "dataPicker",
			"property": "categoryData",
			"dataPickerType": "any",
			"tooltip": "Optional TABLE for public category labels, descriptions, and ordering. Its category key must match the donor category values."
		},
		{
			"label": "Donor data mapping",
			"type": "group",
			"properties": [
				{
					"label": "Donor table name",
					"type": "text",
					"property": "donorTableName",
					"default": "Donor Information"
				},
				{
					"label": "Category column",
					"type": "text",
					"property": "categoryColumn",
					"default": "Category",
					"tooltip": "Values in this column are cross-referenced with the category metadata key column."
				},
				{
					"label": "Entry field 1 column",
					"type": "text",
					"property": "entryField1Column",
					"default": "Name",
					"tooltip": "Required primary value. It identifies each donor and powers search."
				},
				{
					"label": "Entry field 2 column",
					"type": "text",
					"property": "entryField2Column",
					"default": "Amount",
					"tooltip": "Optional. Leave blank to hide the second value."
				},
				{
					"label": "Entry field 3 column",
					"type": "text",
					"property": "entryField3Column",
					"default": "",
					"tooltip": "Optional. Leave blank to hide the third value."
				},
				{
					"label": "Sort column",
					"type": "text",
					"property": "sortColumn",
					"default": "Name"
				},
				{
					"label": "Sort direction",
					"type": "select",
					"property": "sortDirection",
					"default": "ascending",
					"options": [
						{
							"label": "Source order",
							"value": "source"
						},
						{
							"label": "Ascending",
							"value": "ascending"
						},
						{
							"label": "Descending",
							"value": "descending"
						}
					]
				},
				{
					"label": "Locale",
					"type": "text",
					"property": "numberLocale",
					"default": "en-US",
					"tooltip": "Locale used for stable text sorting, grouped number formatting, and header date/time formatting."
				},
				{
					"label": "Format number columns with currency prefix",
					"type": "checkbox",
					"property": "formatNumberColumnsAsCurrency",
					"default": false,
					"tooltip": "When enabled, mapped entry fields whose TABLE header type is number receive grouping separators and the prefix below. Text columns are never reformatted."
				},
				{
					"label": "Currency symbol or prefix",
					"type": "text",
					"property": "currencySymbol",
					"default": "$",
					"tooltip": "Placed directly before formatted number-column values, for example $50,000. You may also enter a longer prefix such as USD .",
					"visibilityConditions": {
						"conditions": [
							{
								"id": "#1",
								"type": "EQUALS",
								"value": true,
								"dependsOn": "formatNumberColumnsAsCurrency"
							}
						],
						"rule": "#1"
					}
				}
			]
		},
		{
			"label": "Category metadata mapping",
			"type": "group",
			"properties": [
				{
					"label": "Category table name",
					"type": "text",
					"property": "categoryTableName",
					"default": "Categories"
				},
				{
					"label": "Category key column",
					"type": "text",
					"property": "categoryKeyColumn",
					"default": "Category",
					"tooltip": "This cross-reference key must match values from the donor category column after trimming and case normalization."
				},
				{
					"label": "Public label column",
					"type": "text",
					"property": "categoryLabelColumn",
					"default": "Label"
				},
				{
					"label": "Description column",
					"type": "text",
					"property": "categoryDescriptionColumn",
					"default": "Description"
				},
				{
					"label": "Show descriptions on category buttons",
					"type": "checkbox",
					"property": "showCategoryButtonDescriptions",
					"default": false,
					"tooltip": "Displays each category metadata description beneath its public label on the category button."
				},
				{
					"label": "Order column",
					"type": "text",
					"property": "categoryOrderColumn",
					"default": "Order"
				}
			]
		},
		{
			"label": "Content and header",
			"type": "group",
			"properties": [
				{
					"label": "Title",
					"type": "text",
					"property": "title",
					"default": "Our Donors"
				},
				{
					"label": "Title font size",
					"type": "number",
					"property": "titleFontSize",
					"default": 46,
					"min": 18,
					"max": 72,
					"step": 1,
					"tooltip": "Sets the preferred title size. Long titles still auto-fit within the available header space."
				},
				{
					"label": "Subtitle",
					"type": "text",
					"property": "subtitle",
					"default": "With gratitude to those who make our work possible"
				},
				{
					"label": "All categories label",
					"type": "text",
					"property": "allLabel",
					"default": "All Donors"
				},
				{
					"label": "All categories label font size",
					"type": "number",
					"property": "allLabelFontSize",
					"default": 27,
					"min": 12,
					"max": 64,
					"step": 1,
					"tooltip": "Sets the size of the All Donors heading above the donor entries. Long labels still auto-fit instead of truncating."
				},
				{
					"label": "Empty datasource message",
					"type": "textArea",
					"property": "emptyStateText",
					"default": "No donor records are available."
				},
				{
					"label": "No search results message",
					"type": "textArea",
					"property": "noResultsText",
					"default": "No donors match your search."
				},
				{
					"label": "Search placeholder",
					"type": "text",
					"property": "searchPlaceholder",
					"default": "Search donor names"
				},
				{
					"label": "Header logo",
					"type": "file",
					"property": "logo",
					"tooltip": "Optional Wallboard-managed logo. Leave unselected to use the full header for text."
				},
				{
					"label": "Logo height",
					"type": "number",
					"property": "logoScale",
					"default": 72,
					"min": 32,
					"max": 180,
					"step": 1
				},
				{
					"label": "Date format",
					"type": "select",
					"property": "dateFormat",
					"default": "long",
					"options": [
						{
							"label": "Long",
							"value": "long"
						},
						{
							"label": "Short",
							"value": "short"
						},
						{
							"label": "None",
							"value": "none"
						}
					]
				},
				{
					"label": "Time format",
					"type": "select",
					"property": "timeFormat",
					"default": "12-hour",
					"options": [
						{
							"label": "12-hour",
							"value": "12-hour"
						},
						{
							"label": "24-hour",
							"value": "24-hour"
						},
						{
							"label": "None",
							"value": "none"
						}
					]
				},
				{
					"label": "Time zone",
					"type": "text",
					"property": "timeZone",
					"default": "",
					"tooltip": "Optional IANA time zone, such as America/New_York. Blank or invalid values use the device time zone."
				}
			]
		},
		{
			"label": "Directory behavior",
			"type": "group",
			"properties": [
				{
					"label": "Maximum columns",
					"type": "number",
					"property": "directoryColumns",
					"default": 3,
					"min": 1,
					"max": 4,
					"step": 1,
					"tooltip": "Sets the upper limit for the donor grid. Landscape supports up to 4 columns, portrait up to 3, and square placements up to 2; compact landscape placements may use fewer columns to preserve readability."
				},
				{
					"label": "Entries per column",
					"type": "number",
					"property": "entriesPerColumn",
					"default": 8,
					"min": 1,
					"max": 20,
					"step": 1,
					"tooltip": "Higher values reduce row padding and text sizes down to each field's configured maximum and readable floor."
				},
				{
					"label": "Maximum donor row height",
					"type": "number",
					"property": "maximumRowHeight",
					"default": 0,
					"min": 0,
					"max": 320,
					"step": 1,
					"tooltip": "Optional pixel cap for donor rows on sparse pages. Use 0 to preserve the current automatic equal-height sizing."
				},
				{
					"label": "Enable touch keyboard",
					"type": "checkbox",
					"property": "showKeyboard",
					"default": true,
					"tooltip": "Adds a keyboard icon beside search. The keyboard opens only when requested."
				},
				{
					"label": "Autoplay seconds per page",
					"type": "number",
					"property": "autoplayIntervalSeconds",
					"default": 8,
					"min": 3,
					"max": 120,
					"step": 1,
					"tooltip": "Fallback duration used when the enable pagination action does not provide a valid override."
				},
				{
					"label": "Stop at final page",
					"type": "checkbox",
					"property": "stopAtEnd",
					"default": false,
					"tooltip": "Applies only while pagination mode was started by the enablePaginationMode Wallboard action."
				},
				{
					"label": "Motion",
					"type": "select",
					"property": "motionPreset",
					"default": "subtle",
					"options": [
						{
							"label": "Off",
							"value": "off"
						},
						{
							"label": "Subtle",
							"value": "subtle"
						}
					]
				}
			]
		},
		{
			"label": "Display typography",
			"type": "group",
			"properties": [
				{
					"type": "fontFamily",
					"propertyContainer": "displayFont"
				},
				{
					"type": "fontStyle",
					"propertyContainer": "displayFont"
