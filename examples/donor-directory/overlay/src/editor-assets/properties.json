					"max": 32,
					"step": 1
				},
				{
					"label": "Background image",
					"type": "file",
					"property": "backgroundImage",
					"tooltip": "Optional Wallboard-managed canvas image for Light, Dark, or Custom. Clearing it restores the packaged mint image in Light/Custom and the solid canvas in Dark."
				},
				{
					"label": "Background overlay color",
					"type": "color",
