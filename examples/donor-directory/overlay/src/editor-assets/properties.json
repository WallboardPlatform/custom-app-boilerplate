					"label": "Color scheme",
					"type": "select",
					"property": "themePreset",
					"default": "light",
					"tooltip": "Light and Dark are complete coordinated palettes. Choose Custom to edit every semantic color below. Background image and overlay controls remain available in every scheme.",
