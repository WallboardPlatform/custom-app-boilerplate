{
	"version": "1",
	"name": "Newsroom Spotlight",
	"interactive": false,
	"size": {
		"width": "1920px",
		"height": "1080px"
	},
	"properties": [
		{
			"label": "Feed datasource",
			"type": "dataPicker",
			"property": "feedData",
			"dataPickerType": "any",
			"tooltip": "Select an integrated Wallboard feed or RSS datasource."
		},
		{
			"label": "Content",
			"type": "group",
			"properties": [
				{ "label": "Source label", "type": "text", "property": "sourceLabel", "default": "Field notes" },
				{ "label": "Empty state", "type": "text", "property": "emptyStateText", "default": "No stories are available." },
				{ "label": "Rotation seconds", "type": "number", "property": "rotationSeconds", "default": 8, "min": 2, "max": 120, "step": 1 },
				{ "label": "Maximum stories", "type": "number", "property": "maxStories", "default": 6, "min": 1, "max": 12, "step": 1 },
				{ "label": "Show description", "type": "checkbox", "property": "showDescription", "default": true },
				{ "label": "Show timestamp", "type": "checkbox", "property": "showTimestamp", "default": true },
				{
					"label": "Image position",
					"type": "select",
					"property": "imagePosition",
					"default": "left",
					"options": [
						{ "label": "Left", "value": "left" },
						{ "label": "Right", "value": "right" }
					]
				}
			]
		},
		{
			"label": "Appearance",
			"type": "group",
			"properties": [
				{
					"label": "Color scheme", "type": "select", "property": "themePreset", "default": "light",
					"tooltip": "Light and Dark are coordinated presets. Choose Custom to use the color controls below.",
					"options": [
						{ "label": "Light", "value": "light" }, { "label": "Dark", "value": "dark" },
						{ "label": "Custom", "value": "custom" }
					]
				},
				{ "label": "Outer background", "type": "color", "property": "backgroundColor", "default": "#f2efe8", "visibilityConditions": {"conditions": [{"id": "#1", "type": "EQUALS", "value": "custom", "dependsOn": "themePreset"}], "rule": "#1"} },
				{ "label": "Story surface", "type": "color", "property": "panelColor", "default": "#17211f", "visibilityConditions": {"conditions": [{"id": "#1", "type": "EQUALS", "value": "custom", "dependsOn": "themePreset"}], "rule": "#1"} },
				{ "label": "Primary text", "type": "color", "property": "primaryTextColor", "default": "#f9f7f0", "visibilityConditions": {"conditions": [{"id": "#1", "type": "EQUALS", "value": "custom", "dependsOn": "themePreset"}], "rule": "#1"} },
				{ "label": "Secondary text", "type": "color", "property": "secondaryTextColor", "default": "#b9c4bf", "visibilityConditions": {"conditions": [{"id": "#1", "type": "EQUALS", "value": "custom", "dependsOn": "themePreset"}], "rule": "#1"} },
				{ "label": "Accent", "type": "color", "property": "accentColor", "default": "#ef5b45", "visibilityConditions": {"conditions": [{"id": "#1", "type": "EQUALS", "value": "custom", "dependsOn": "themePreset"}], "rule": "#1"} }
			]
		}
	],
	"resourceList": [
		"assets/app.js",
		"assets/app-chrome-49.js"
	],
	"externalCommands": []
}
