{
	"version": "1",
	"name": "Greenline Pharmacy Pickup Queue",
	"interactive": false,
	"size": {
		"width": "480px",
		"height": "270px"
	},
	"properties": [
		{
			"label": "Pickup queue datasource",
			"type": "dataPicker",
			"property": "queueData",
			"dataPickerType": "any",
			"tooltip": "Select the PharmacyQueue table. Leave unbound to show representative sample tickets."
		},
		{
			"label": "Content",
			"type": "group",
			"properties": [
				{
					"label": "Pharmacy name",
					"type": "text",
					"property": "pharmacyName",
					"default": "Greenline Pharmacy"
				},
				{
					"label": "Empty queue message",
					"type": "text",
					"property": "emptyStateText",
					"default": "No pickup tickets are waiting."
				}
			]
		},
		{
			"label": "Appearance",
			"type": "group",
			"properties": [
				{
					"label": "Color scheme",
					"type": "select",
					"property": "themePreset",
					"default": "light",
					"tooltip": "Light and Dark are coordinated presets. Choose Custom to use the colors below.",
					"options": [
						{ "label": "Light", "value": "light" },
						{ "label": "Dark", "value": "dark" },
						{ "label": "Custom", "value": "custom" }
					]
				},
				{ "label": "Background", "type": "color", "property": "backgroundColor", "default": "#e9f1ed", "visibilityConditions": {"conditions": [{"id": "#1", "type": "EQUALS", "value": "custom", "dependsOn": "themePreset"}], "rule": "#1"} },
				{ "label": "Called ticket background", "type": "color", "property": "heroBackgroundColor", "default": "#07594b", "visibilityConditions": {"conditions": [{"id": "#1", "type": "EQUALS", "value": "custom", "dependsOn": "themePreset"}], "rule": "#1"} },
				{ "label": "Next queue surface", "type": "color", "property": "surfaceColor", "default": "#ffffff", "visibilityConditions": {"conditions": [{"id": "#1", "type": "EQUALS", "value": "custom", "dependsOn": "themePreset"}], "rule": "#1"} },
				{ "label": "Primary text", "type": "color", "property": "primaryTextColor", "default": "#17372f", "visibilityConditions": {"conditions": [{"id": "#1", "type": "EQUALS", "value": "custom", "dependsOn": "themePreset"}], "rule": "#1"} },
				{ "label": "Secondary text", "type": "color", "property": "secondaryTextColor", "default": "#52675f", "visibilityConditions": {"conditions": [{"id": "#1", "type": "EQUALS", "value": "custom", "dependsOn": "themePreset"}], "rule": "#1"} },
				{ "label": "Waiting accent", "type": "color", "property": "accentColor", "default": "#8a5a00", "visibilityConditions": {"conditions": [{"id": "#1", "type": "EQUALS", "value": "custom", "dependsOn": "themePreset"}], "rule": "#1"} },
				{ "label": "Hold and unknown accent", "type": "color", "property": "alertColor", "default": "#b34332", "visibilityConditions": {"conditions": [{"id": "#1", "type": "EQUALS", "value": "custom", "dependsOn": "themePreset"}], "rule": "#1"} }
			]
		}
	],
	"resourceList": [
		"assets/app.js",
		"assets/app-chrome-49.js"
	],
	"externalCommands": []
}
