{
	"contractVersion": 1,
	"sampleDataClassification": "synthetic",
	"bindings": [
		{
			"property": "products",
			"dataPickerType": "any",
			"source": {
				"contract": "TABLE",
				"table": "Products",
				"sampleData": "sample-products-table-datasource.json"
			},
			"delivery": {
				"suggestedDatasourceName": "Field Note Products",
				"quickEditEligible": true
			},
			"columns": [
				{ "name": "sku", "type": "string", "required": true },
				{ "name": "name", "type": "string", "required": true },
				{ "name": "category", "type": "string", "required": true },
				{ "name": "description", "type": "text", "required": true },
				{ "name": "price", "type": "string", "required": true },
				{ "name": "badge", "type": "string", "required": false },
				{ "name": "availability", "type": "string", "required": false },
				{ "name": "detailOne", "type": "string", "required": false },
				{ "name": "detailTwo", "type": "string", "required": false },
				{ "name": "imageKey", "type": "string", "required": false },
				{ "name": "sortOrder", "type": "number", "required": true }
			]
		},
		{
			"property": "productImages",
			"dataPickerType": "any",
			"source": {
				"contract": "EXISTING",
				"sampleData": "sample-product-images-filesystem-datasource.json"
			},
			"delivery": {
				"suggestedDatasourceName": "Field Note Product Images (File System)",
				"quickEditEligible": false
			}
		}
	],
	"rationale": "Product copy and order remain quick-editable TABLE rows. Images stay in an independently managed File System datasource and match the row imageKey to the image filename stem.",
	"behavior": {
		"unbound": "render bundled synthetic product rows with designed no-image treatments",
		"boundEmpty": "render the configured empty-state message",
		"invalidRows": "skip rows missing sku, name, or category",
		"assetLookup": "match Products.imageKey to File System content[].name without its extension",
		"assetFallback": "show a color-led product silhouette when an image is missing or fails",
		"pagination": "rotate one product per page and preserve the active product across live data reordering"
	}
}
