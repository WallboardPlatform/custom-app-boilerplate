{
	"compilerOptions": {
		"allowJs": true,
		"allowImportingTsExtensions": true,
		"checkJs": false,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmit": true,
		"noImplicitReturns": true,
		"resolveJsonModule": true,
		"strict": true,
		"target": "ES2022",
		"types": ["node"]
	},
	"include": [
		"scripts/**/*.mts",
		"scripts/**/*.mjs"
	]
}
