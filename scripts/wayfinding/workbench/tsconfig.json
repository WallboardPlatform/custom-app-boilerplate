{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"noImplicitReturns": true,
		"resolveJsonModule": true,
		"strict": true,
		"target": "ES2022",
		"types": ["node"]
	},
	"include": ["*.ts"]
}
