{
	"version": "1",
	"name": "Boilerplate",
	"interactive": false,
	"size": {
		"width": "1280px",
		"height": "720px"
	},
	"properties": [
		{
			"label": "Content",
			"type": "group",
			"properties": [
				{
					"label": "Title",
					"type": "text",
					"property": "title",
					"default": "Your custom app",
					"quickEdit": {
						"label": "Title",
						"defaultEnabled": true
					}
				}
			]
		},
		{
			"label": "Appearance",
			"type": "group",
			"properties": [
				{
					"label": "Accent color",
					"type": "color",
					"property": "accentColor",
					"default": "#15c39a",
					"quickEdit": true
				},
				{
					"label": "Text color",
					"type": "color",
					"property": "textColor",
					"default": "#f4f7f6"
				},
				{
					"label": "Background color",
					"type": "color",
					"property": "backgroundColor",
					"default": "#111516"
				}
			]
		}
	],
	"resourceList": [
		"assets/app.js",
		"assets/app-chrome-49.js"
	]
}
