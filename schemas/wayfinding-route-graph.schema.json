{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://wallboard.info/schemas/wayfinding-route-graph.schema.json",
	"title": "Wallboard Wayfinding Route Graph",
	"type": "object",
	"additionalProperties": false,
	"required": ["contractVersion", "graphId", "nodes", "edges"],
	"properties": {
		"contractVersion": { "const": 1 },
		"graphId": { "$ref": "#/$defs/nonEmptyString" },
		"nodes": {
			"type": "array",
			"minItems": 2,
			"items": { "$ref": "#/$defs/node" }
		},
		"edges": {
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/$defs/edge" }
		},
		"generation": {
			"type": "object",
			"additionalProperties": false,
			"required": ["mode"],
			"properties": {
				"mode": { "enum": ["explicit", "legacy-proximity"] },
				"sensitivity": { "type": "number", "exclusiveMinimum": 0 }
			}
		}
	},
	"$defs": {
		"nonEmptyString": { "type": "string", "minLength": 1, "pattern": "\\S" },
		"node": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "levelId", "kind", "x", "y"],
			"properties": {
				"id": { "$ref": "#/$defs/nonEmptyString" },
				"levelId": { "$ref": "#/$defs/nonEmptyString" },
				"kind": { "enum": ["route", "location", "transition"] },
				"x": { "type": "number" },
				"y": { "type": "number" },
				"locationId": { "$ref": "#/$defs/nonEmptyString" }
			},
			"allOf": [
				{
					"if": { "properties": { "kind": { "const": "location" } } },
					"then": {
						"required": ["locationId"],
						"properties": { "locationId": { "$ref": "#/$defs/nonEmptyString" } }
					}
				}
			]
		},
		"edge": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "from", "to", "kind", "accessible", "bidirectional"],
			"properties": {
				"id": { "$ref": "#/$defs/nonEmptyString" },
				"from": { "$ref": "#/$defs/nonEmptyString" },
				"to": { "$ref": "#/$defs/nonEmptyString" },
				"kind": { "enum": ["walk", "outdoor", "stairs", "elevator", "escalator", "shuttle"] },
				"accessible": { "type": "boolean" },
				"bidirectional": { "type": "boolean" },
				"distanceMeters": { "type": "number", "exclusiveMinimum": 0 }
			}
		}
	}
}
