{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://wallboard.info/schemas/wayfinding-route-graph.schema.json",
	"title": "Wallboard Wayfinding Route Graph",
	"type": "object",
	"additionalProperties": false,
	"required": ["graphId", "nodes", "edges"],
	"properties": {
		"graphId": { "$ref": "#/$defs/nonEmptyString" },
		"nodes": {
			"type": "array",
			"items": { "$ref": "#/$defs/node" }
		},
		"edges": {
			"type": "array",
			"items": { "$ref": "#/$defs/edge" }
		}
	},
	"$defs": {
		"nonEmptyString": { "type": "string", "minLength": 1, "pattern": "\\S" },
		"node": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "levelId", "kind", "x", "y"],
			"properties": {
				"authoringOwnership": { "enum": ["generated", "manual"] },
				"id": { "$ref": "#/$defs/nonEmptyString" },
				"levelId": { "$ref": "#/$defs/nonEmptyString" },
				"kind": { "enum": ["route", "location", "transition"] },
				"x": { "type": "number" },
				"y": { "type": "number" },
				"locationId": { "$ref": "#/$defs/nonEmptyString" },
				"semanticElementId": { "$ref": "#/$defs/nonEmptyString" }
			},
			"allOf": [
				{
					"if": { "properties": { "kind": { "const": "location" } } },
					"then": {
						"required": ["locationId"],
						"properties": { "locationId": { "$ref": "#/$defs/nonEmptyString" } }
					}
				}
			]
		},
		"edge": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "from", "to", "kind", "accessible", "bidirectional", "reviewStatus", "traversal"],
			"properties": {
				"authoringOwnership": { "enum": ["generated", "manual"] },
				"id": { "$ref": "#/$defs/nonEmptyString" },
				"from": { "$ref": "#/$defs/nonEmptyString" },
				"to": { "$ref": "#/$defs/nonEmptyString" },
				"kind": { "enum": ["walk", "outdoor", "stairs", "elevator", "escalator", "shuttle"] },
				"accessible": { "type": "boolean" },
				"bidirectional": { "type": "boolean" },
				"corridorWidth": { "type": "number", "exclusiveMinimum": 0 },
				"distanceMeters": { "type": "number", "exclusiveMinimum": 0 },
				"geometry": {
					"type": "array",
					"minItems": 2,
					"items": { "$ref": "#/$defs/point" }
				},
				"reviewStatus": { "enum": ["confirmed", "proposed"] },
				"traversal": { "enum": ["outdoor-path", "crossing", "indoor-corridor", "open-area", "portal", "transition"] }
			}
		},
		"point": {
			"type": "object",
			"additionalProperties": false,
			"required": ["x", "y"],
			"properties": {
				"x": { "type": "number" },
				"y": { "type": "number" }
			}
		}
	}
}
