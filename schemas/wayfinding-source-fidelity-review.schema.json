{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://wallboard.info/schemas/wayfinding-source-fidelity-review.schema.json",
	"title": "Wallboard Wayfinding Source Fidelity Review",
	"type": "object",
	"additionalProperties": false,
	"required": ["reviewVersion", "projectId", "contractPath", "contractHash", "reviewer", "comparisons", "invariantResults", "unresolvedFindings"],
	"properties": {
		"reviewVersion": { "const": 1 },
		"projectId": { "$ref": "#/$defs/nonEmptyString" },
		"contractPath": { "$ref": "#/$defs/nonEmptyString" },
		"contractHash": { "$ref": "#/$defs/sha256" },
		"reviewer": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "context", "reviewedAt"],
			"properties": {
				"id": { "$ref": "#/$defs/nonEmptyString" },
				"context": { "enum": ["independent-ai", "human", "customer"] },
				"reviewedAt": { "$ref": "#/$defs/nonEmptyString" }
			}
		},
		"comparisons": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["levelId", "sourceImage", "sourceHash", "candidateImage", "candidateHash", "status", "notes"],
				"properties": {
					"levelId": { "$ref": "#/$defs/id" },
					"sourceImage": { "$ref": "#/$defs/nonEmptyString" },
					"sourceHash": { "$ref": "#/$defs/sha256" },
					"candidateImage": { "$ref": "#/$defs/nonEmptyString" },
					"candidateHash": { "$ref": "#/$defs/sha256" },
					"status": { "enum": ["pass", "fail"] },
					"notes": { "$ref": "#/$defs/nonEmptyString" }
				}
			}
		},
		"invariantResults": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["invariantId", "status", "notes"],
				"properties": {
					"invariantId": { "$ref": "#/$defs/id" },
					"status": { "enum": ["pass", "fail", "not-applicable"] },
					"notes": { "$ref": "#/$defs/nonEmptyString" }
				}
			}
		},
		"unresolvedFindings": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } }
	},
	"$defs": {
		"nonEmptyString": { "type": "string", "minLength": 1, "pattern": "\\S" },
		"id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
		"sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
	}
}
