{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://wallboard.info/schemas/wayfinding-studio-project.schema.json",
	"title": "Wallboard Wayfinding Studio Project",
	"type": "object",
	"additionalProperties": false,
	"required": ["format", "formatVersion", "projectId", "name", "createdAt", "updatedAt", "assets", "buildings", "connectors", "levels", "graph", "destinations", "presentation"],
	"properties": {
		"format": { "const": "wallboard-wayfinding-studio" },
		"formatVersion": { "const": 2 },
		"projectId": { "$ref": "#/$defs/nonEmptyString" },
		"name": { "$ref": "#/$defs/nonEmptyString" },
		"createdAt": { "$ref": "#/$defs/nonEmptyString" },
		"updatedAt": { "$ref": "#/$defs/nonEmptyString" },
		"defaultLanguage": { "$ref": "#/$defs/nonEmptyString" },
		"defaults": { "$ref": "#/$defs/projectDefaults" },
		"assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
		"buildings": { "type": "array", "items": { "$ref": "#/$defs/building" } },
		"connectors": { "type": "array", "items": { "$ref": "#/$defs/connector" } },
		"categories": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }, "uniqueItems": true },
		"languages": { "type": "array", "items": { "$ref": "#/$defs/language" } },
		"levels": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/level" } },
		"presentation": { "$ref": "#/$defs/presentation" },
		"siteLevelId": { "$ref": "#/$defs/nonEmptyString" },
		"graph": {
			"type": "object",
			"additionalProperties": false,
			"required": ["graphId", "nodes", "edges"],
			"properties": {
				"graphId": { "$ref": "#/$defs/nonEmptyString" },
				"nodes": { "type": "array", "items": { "$ref": "wayfinding-route-graph.schema.json#/$defs/node" } },
				"edges": { "type": "array", "items": { "$ref": "wayfinding-route-graph.schema.json#/$defs/edge" } }
			}
		},
		"destinations": { "type": "array", "items": { "$ref": "#/$defs/destination" } }
	},
	"$defs": {
		"nonEmptyString": { "type": "string", "minLength": 1, "pattern": "\\S" },
		"point": {
			"type": "object",
			"additionalProperties": false,
			"required": ["x", "y"],
			"properties": { "x": { "type": "number" }, "y": { "type": "number" } }
		},
		"camera3d": {
			"type": "object",
			"additionalProperties": false,
			"required": ["azimuthDegrees", "distance", "pitchDegrees", "targetX", "targetY"],
			"properties": {
				"azimuthDegrees": { "type": "number" },
				"distance": { "type": "number", "exclusiveMinimum": 0 },
				"pitchDegrees": { "type": "number", "minimum": 5, "maximum": 85 },
				"targetX": { "type": "number" },
				"targetY": { "type": "number" }
			}
		},
		"alignment": {
			"type": "object",
			"additionalProperties": false,
			"required": ["siteLevelId", "x", "y", "rotationDegrees", "scale"],
			"properties": {
				"siteLevelId": { "$ref": "#/$defs/nonEmptyString" },
				"x": { "type": "number" },
				"y": { "type": "number" },
				"rotationDegrees": { "type": "number" },
				"scale": { "type": "number", "exclusiveMinimum": 0 }
			}
		},
		"presentation": {
			"type": "object",
			"additionalProperties": false,
			"required": ["buildingTapBehavior", "defaultOverviewMode", "enabledOverviewModes"],
			"properties": {
				"buildingTapBehavior": { "enum": ["focus-actions", "enter-immediately"] },
				"defaultOverviewMode": { "enum": ["site", "exploded-3d"] },
				"enabledOverviewModes": { "type": "array", "uniqueItems": true, "items": { "enum": ["site", "exploded-3d"] } }
			}
		},
		"polygonPresentation": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"extrusionHeight": { "type": "number", "minimum": 0, "maximum": 100 },
				"fillColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
				"fillOpacity": { "type": "number", "minimum": 0, "maximum": 1 }
			}
		},
		"language": {
			"type": "object",
			"additionalProperties": false,
			"required": ["code", "label"],
			"properties": {
				"code": { "$ref": "#/$defs/nonEmptyString" },
				"label": { "$ref": "#/$defs/nonEmptyString" }
			}
		},
		"projectDefaults": {
			"type": "object",
			"additionalProperties": false,
			"required": ["iconSize", "label", "location", "locationColor", "logoSize", "obstacle", "origin", "route", "walkable"],
			"properties": {
				"iconSize": { "type": "number", "minimum": 8, "maximum": 1024 },
				"logoSize": { "type": "number", "minimum": 8, "maximum": 1024 },
				"location": { "$ref": "#/$defs/requiredPolygonPresentation" },
				"locationColor": {
					"type": "object",
					"additionalProperties": false,
					"required": ["fixedColor", "mode"],
					"properties": {
						"fixedColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
						"mode": { "enum": ["fixed", "inherited", "random"] }
					}
				},
				"obstacle": { "$ref": "#/$defs/requiredPolygonPresentation" },
				"origin": {
					"type": "object",
					"additionalProperties": false,
					"required": ["animation2d", "animation3d", "animationSpeed", "color"],
					"properties": {
						"animation2d": { "enum": ["none", "pulse", "radar"] },
						"animation3d": { "enum": ["bounce", "none", "pulse"] },
						"animationSpeed": { "type": "number", "minimum": 1, "maximum": 300 },
						"color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
						"markerAssetId": { "$ref": "#/$defs/nonEmptyString" },
						"markerSize2d": { "type": "number", "minimum": 20, "maximum": 96 },
						"markerSize3d": { "type": "number", "minimum": 28, "maximum": 120 }
					}
				},
				"walkable": { "$ref": "#/$defs/requiredPolygonPresentation" },
				"label": {
					"type": "object",
					"additionalProperties": false,
					"required": ["color", "fontFamily", "fontSize", "fontWeight", "outlineColor", "outlineWidth"],
					"properties": {
						"color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
						"fontFamily": { "enum": ["sans-serif", "serif", "monospace"] },
						"fontSize": { "type": "number", "minimum": 6, "maximum": 512 },
						"fontSize3d": { "type": "number", "minimum": 11, "maximum": 32 },
						"fontWeight": { "enum": [400, 600, 700] },
						"outlineColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
						"outlineWidth": { "type": "number", "minimum": 0, "maximum": 16 }
					}
				},
				"route": {
					"type": "object",
					"additionalProperties": false,
					"required": ["animation", "animationSpeed", "color", "cornerRadius", "lineWidth"],
					"properties": {
						"animation": { "enum": ["flow", "none", "pulse"] },
						"animationSpeed": { "type": "number", "minimum": 1, "maximum": 300 },
						"color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
						"cornerRadius": { "type": "number", "minimum": 0, "maximum": 200 },
						"lineWidth": { "type": "number", "minimum": 1, "maximum": 64 }
					}
				}
			}
		},
		"requiredPolygonPresentation": {
			"type": "object",
			"additionalProperties": false,
			"required": ["extrusionHeight", "fillColor", "fillOpacity"],
			"properties": {
				"extrusionHeight": { "type": "number", "minimum": 0, "maximum": 100 },
				"fillColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
				"fillOpacity": { "type": "number", "minimum": 0, "maximum": 1 }
			}
		},
		"asset": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "name", "kind", "mimeType", "dataUrl"],
			"properties": {
				"id": { "$ref": "#/$defs/nonEmptyString" },
				"name": { "$ref": "#/$defs/nonEmptyString" },
				"kind": { "enum": ["background", "icon", "logo", "marker", "photo"] },
				"mimeType": { "$ref": "#/$defs/nonEmptyString" },
				"dataUrl": { "type": "string", "pattern": "^data:" },
				"naturalHeight": { "type": "number", "exclusiveMinimum": 0 },
				"naturalWidth": { "type": "number", "exclusiveMinimum": 0 }
			}
		},
		"polygonElement": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "levelId", "status", "provenance", "type", "geometry"],
			"properties": {
				"id": { "$ref": "#/$defs/nonEmptyString" }, "levelId": { "$ref": "#/$defs/nonEmptyString" },
				"status": { "enum": ["confirmed", "proposed"] }, "provenance": { "enum": ["ai-draft", "customer-source", "reviewer-authored"] },
				"type": { "enum": ["building", "location", "obstacle", "walkable"] }, "geometry": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/point" } },
				"buildingId": { "$ref": "#/$defs/nonEmptyString" },
				"label": { "type": "string" }, "destinationId": { "$ref": "#/$defs/nonEmptyString" },
				"presentation": { "$ref": "#/$defs/polygonPresentation" }
			}
		},
		"doorElement": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "levelId", "status", "provenance", "type", "point", "angle", "length"],
			"properties": {
				"id": { "$ref": "#/$defs/nonEmptyString" }, "levelId": { "$ref": "#/$defs/nonEmptyString" },
				"status": { "enum": ["confirmed", "proposed"] }, "provenance": { "enum": ["ai-draft", "customer-source", "reviewer-authored"] },
				"type": { "const": "door" }, "point": { "$ref": "#/$defs/point" }, "angle": { "type": "number" }, "length": { "type": "number", "exclusiveMinimum": 0 },
				"locationId": { "$ref": "#/$defs/nonEmptyString" }
			}
		},
		"poiElement": {
			"type": "object", "additionalProperties": false,
			"required": ["id", "levelId", "status", "provenance", "type", "point"],
			"properties": {
				"id": { "$ref": "#/$defs/nonEmptyString" }, "levelId": { "$ref": "#/$defs/nonEmptyString" },
				"status": { "enum": ["confirmed", "proposed"] }, "provenance": { "enum": ["ai-draft", "customer-source", "reviewer-authored"] },
				"type": { "const": "poi" }, "point": { "$ref": "#/$defs/point" }, "category": { "type": "string" }, "destinationId": { "$ref": "#/$defs/nonEmptyString" }, "label": { "type": "string" }
			}
		},
		"originElement": {
			"type": "object", "additionalProperties": false,
			"required": ["id", "levelId", "status", "provenance", "type", "point", "facingDegrees", "label", "screenId"],
			"properties": {
				"id": { "$ref": "#/$defs/nonEmptyString" }, "levelId": { "$ref": "#/$defs/nonEmptyString" },
				"status": { "enum": ["confirmed", "proposed"] }, "provenance": { "enum": ["ai-draft", "customer-source", "reviewer-authored"] },
				"type": { "const": "origin" }, "point": { "$ref": "#/$defs/point" }, "defaultLanguage": { "type": "string" }, "facingDegrees": { "type": "number" }, "label": { "$ref": "#/$defs/nonEmptyString" }, "screenId": { "$ref": "#/$defs/nonEmptyString" }
			}
		},
		"transitionElement": {
			"type": "object", "additionalProperties": false,
			"required": ["id", "levelId", "status", "provenance", "type", "point", "accessible", "connectionId", "kind", "label"],
			"properties": {
				"id": { "$ref": "#/$defs/nonEmptyString" }, "levelId": { "$ref": "#/$defs/nonEmptyString" },
				"status": { "enum": ["confirmed", "proposed"] }, "provenance": { "enum": ["ai-draft", "customer-source", "reviewer-authored"] },
				"type": { "const": "transition" }, "point": { "$ref": "#/$defs/point" }, "accessible": { "type": "boolean" }, "connectionId": { "$ref": "#/$defs/nonEmptyString" }, "kind": { "enum": ["elevator", "escalator", "ramp", "stairs"] }, "label": { "$ref": "#/$defs/nonEmptyString" }
			}
		},
		"labelElement": {
			"type": "object", "additionalProperties": false,
			"required": ["id", "levelId", "status", "provenance", "type", "point", "text"],
			"properties": {
				"id": { "$ref": "#/$defs/nonEmptyString" }, "levelId": { "$ref": "#/$defs/nonEmptyString" },
				"status": { "enum": ["confirmed", "proposed"] }, "provenance": { "enum": ["ai-draft", "customer-source", "reviewer-authored"] },
				"type": { "const": "label" }, "point": { "$ref": "#/$defs/point" }, "text": { "type": "string" },
				"fontFamily": { "enum": ["sans-serif", "serif", "monospace"] }, "fontSize": { "type": "number", "minimum": 6, "maximum": 512 },
				"fontWeight": { "enum": [400, 600, 700] }, "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
				"textAnchor": { "enum": ["start", "middle", "end"] }, "outlineColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
				"outlineWidth": { "type": "number", "minimum": 0, "maximum": 16 }
			}
		},
		"mediaElement": {
			"type": "object", "additionalProperties": false,
			"required": ["id", "levelId", "status", "provenance", "type", "point", "assetId", "width", "height"],
			"properties": {
				"id": { "$ref": "#/$defs/nonEmptyString" }, "levelId": { "$ref": "#/$defs/nonEmptyString" },
				"status": { "enum": ["confirmed", "proposed"] }, "provenance": { "enum": ["ai-draft", "customer-source", "reviewer-authored"] },
				"type": { "enum": ["icon", "logo"] }, "point": { "$ref": "#/$defs/point" }, "assetId": { "$ref": "#/$defs/nonEmptyString" }, "destinationId": { "$ref": "#/$defs/nonEmptyString" }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 }, "rotationDegrees": { "type": "number" }
			}
		},
		"level": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "name", "order", "role", "width", "height", "elements"],
			"properties": {
				"id": { "$ref": "#/$defs/nonEmptyString" }, "name": { "$ref": "#/$defs/nonEmptyString" }, "order": { "type": "integer" },
				"role": { "enum": ["site", "building-floor", "standalone"] },
				"buildingId": { "$ref": "#/$defs/nonEmptyString" },
				"levelNumber": { "type": "number" },
				"elevationMeters": { "type": "number" },
				"alignment": { "$ref": "#/$defs/alignment" },
				"width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 },
				"backgroundAssetId": { "$ref": "#/$defs/nonEmptyString" },
				"camera3d": { "$ref": "#/$defs/camera3d" },
				"unitsPerMeter": { "type": "number", "exclusiveMinimum": 0 },
				"elements": { "type": "array", "items": { "oneOf": [
					{ "$ref": "#/$defs/polygonElement" }, { "$ref": "#/$defs/doorElement" }, { "$ref": "#/$defs/poiElement" },
					{ "$ref": "#/$defs/originElement" }, { "$ref": "#/$defs/transitionElement" }, { "$ref": "#/$defs/labelElement" }, { "$ref": "#/$defs/mediaElement" }
				] } }
			}
		},
		"building": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "name", "footprintElementId", "siteLevelId"],
			"properties": {
				"id": { "$ref": "#/$defs/nonEmptyString" },
				"name": { "$ref": "#/$defs/nonEmptyString" },
				"footprintElementId": { "$ref": "#/$defs/nonEmptyString" },
				"siteLevelId": { "$ref": "#/$defs/nonEmptyString" },
				"defaultLevelId": { "$ref": "#/$defs/nonEmptyString" },
				"preferredEntranceConnectorId": { "$ref": "#/$defs/nonEmptyString" },
				"preferredExternalEntranceId": { "$ref": "#/$defs/nonEmptyString" },
				"accessible": { "type": "boolean" },
				"category": { "type": "string" },
				"description": { "type": "string" },
				"externalEntrances": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["id", "label", "accessible", "point"],
						"properties": {
							"id": { "$ref": "#/$defs/nonEmptyString" },
							"label": { "$ref": "#/$defs/nonEmptyString" },
							"accessible": { "type": "boolean" },
							"point": { "$ref": "#/$defs/point" }
						}
					}
				},
				"externalRouteBehavior": { "enum": ["nearest-entrance", "preferred-entrance"] },
				"heightMeters": { "type": "number", "exclusiveMinimum": 0 },
				"hours": { "type": "string" },
				"logoAssetId": { "$ref": "#/$defs/nonEmptyString" },
				"phone": { "type": "string" },
				"photoAssetIds": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }, "uniqueItems": true },
				"website": { "type": "string" }
			}
		},
		"connectorEndpoint": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "levelId", "point"],
			"properties": {
				"id": { "$ref": "#/$defs/nonEmptyString" },
				"levelId": { "$ref": "#/$defs/nonEmptyString" },
				"point": { "$ref": "#/$defs/point" },
				"role": { "enum": ["site", "interior"] }
			}
		},
		"connector": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "label", "kind", "accessible", "bidirectional", "endpoints", "provenance", "status"],
			"properties": {
				"id": { "$ref": "#/$defs/nonEmptyString" },
				"label": { "$ref": "#/$defs/nonEmptyString" },
				"kind": { "enum": ["entrance", "elevator", "stairs", "escalator", "ramp"] },
				"accessible": { "type": "boolean" },
				"bidirectional": { "type": "boolean" },
				"endpoints": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/connectorEndpoint" } },
				"provenance": { "enum": ["ai-draft", "customer-source", "reviewer-authored"] },
				"status": { "enum": ["confirmed", "proposed"] }
			}
		},
		"destination": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "name"],
			"properties": {
				"id": { "$ref": "#/$defs/nonEmptyString" },
				"name": { "$ref": "#/$defs/nonEmptyString" },
				"accessible": { "type": "boolean" },
				"category": { "type": "string" },
				"description": { "type": "string" },
				"levelId": { "type": "string" },
				"hours": { "type": "string" },
				"logoAssetId": { "$ref": "#/$defs/nonEmptyString" },
				"mapNumber": { "type": "string" },
				"phone": { "type": "string" },
				"photoAssetIds": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }, "uniqueItems": true },
				"routeable": { "type": "boolean" },
				"status": { "type": "string" },
				"symbolAssetId": { "$ref": "#/$defs/nonEmptyString" },
				"translations": {
					"type": "object",
					"additionalProperties": {
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"name": { "type": "string" },
							"description": { "type": "string" }
						}
					}
				},
				"website": { "type": "string" }
			}
		}
	}
}
