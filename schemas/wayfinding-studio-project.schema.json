{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://wallboard.info/schemas/wayfinding-studio-project.schema.json",
	"title": "Wallboard Wayfinding Studio Project",
	"type": "object",
	"additionalProperties": false,
	"required": ["contractVersion", "projectId", "name", "createdAt", "updatedAt", "delivery", "assets", "floors", "graph", "destinations"],
	"properties": {
		"contractVersion": { "const": 1 },
		"projectId": { "$ref": "#/$defs/nonEmptyString" },
		"name": { "$ref": "#/$defs/nonEmptyString" },
		"createdAt": { "$ref": "#/$defs/nonEmptyString" },
		"updatedAt": { "$ref": "#/$defs/nonEmptyString" },
		"defaultLanguage": { "$ref": "#/$defs/nonEmptyString" },
		"defaults": { "$ref": "#/$defs/projectDefaults" },
		"delivery": { "$ref": "wayfinding-project.schema.json" },
		"assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
		"categories": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }, "uniqueItems": true },
		"languages": { "type": "array", "items": { "$ref": "#/$defs/language" } },
		"floors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/floor" } },
		"graph": {
			"type": "object",
			"additionalProperties": false,
			"required": ["contractVersion", "graphId", "nodes", "edges"],
			"properties": {
				"contractVersion": { "enum": [1, 2] },
				"graphId": { "$ref": "#/$defs/nonEmptyString" },
				"nodes": { "type": "array", "items": { "$ref": "wayfinding-route-graph.schema.json#/$defs/node" } },
				"edges": { "type": "array", "items": { "$ref": "wayfinding-route-graph.schema.json#/$defs/edge" } }
			}
		},
		"destinations": { "type": "array", "items": { "$ref": "#/$defs/destination" } }
	},
	"$defs": {
		"nonEmptyString": { "type": "string", "minLength": 1, "pattern": "\\S" },
		"point": {
			"type": "object",
			"additionalProperties": false,
			"required": ["x", "y"],
			"properties": { "x": { "type": "number" }, "y": { "type": "number" } }
		},
		"camera3d": {
			"type": "object",
			"additionalProperties": false,
			"required": ["azimuthDegrees", "distance", "pitchDegrees", "targetX", "targetY"],
			"properties": {
				"azimuthDegrees": { "type": "number" },
				"distance": { "type": "number", "exclusiveMinimum": 0 },
				"pitchDegrees": { "type": "number", "minimum": 5, "maximum": 85 },
				"targetX": { "type": "number" },
				"targetY": { "type": "number" }
			}
		},
		"polygonPresentation": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"extrusionHeight": { "type": "number", "minimum": 0, "maximum": 100 },
				"fillColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
				"fillOpacity": { "type": "number", "minimum": 0, "maximum": 1 }
			}
		},
		"language": {
			"type": "object",
			"additionalProperties": false,
			"required": ["code", "label"],
			"properties": {
				"code": { "$ref": "#/$defs/nonEmptyString" },
				"label": { "$ref": "#/$defs/nonEmptyString" }
			}
		},
		"projectDefaults": {
			"type": "object",
			"additionalProperties": false,
			"required": ["iconSize", "label", "location", "locationColor", "logoSize", "obstacle", "origin", "route", "walkable"],
			"properties": {
				"iconSize": { "type": "number", "minimum": 8, "maximum": 1024 },
				"logoSize": { "type": "number", "minimum": 8, "maximum": 1024 },
				"location": { "$ref": "#/$defs/requiredPolygonPresentation" },
				"locationColor": {
					"type": "object",
					"additionalProperties": false,
					"required": ["fixedColor", "mode"],
					"properties": {
						"fixedColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
						"mode": { "enum": ["fixed", "inherited", "random"] }
					}
				},
				"obstacle": { "$ref": "#/$defs/requiredPolygonPresentation" },
				"origin": {
					"type": "object",
					"additionalProperties": false,
					"required": ["animation2d", "animation3d", "animationSpeed", "color"],
					"properties": {
						"animation2d": { "enum": ["none", "pulse", "radar"] },
						"animation3d": { "enum": ["bounce", "none", "pulse"] },
						"animationSpeed": { "type": "number", "minimum": 1, "maximum": 300 },
						"color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
					}
				},
				"walkable": { "$ref": "#/$defs/requiredPolygonPresentation" },
				"label": {
					"type": "object",
					"additionalProperties": false,
					"required": ["color", "fontFamily", "fontSize", "fontWeight", "outlineColor", "outlineWidth"],
					"properties": {
						"color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
						"fontFamily": { "enum": ["sans-serif", "serif", "monospace"] },
						"fontSize": { "type": "number", "minimum": 6, "maximum": 512 },
						"fontWeight": { "enum": [400, 600, 700] },
						"outlineColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
						"outlineWidth": { "type": "number", "minimum": 0, "maximum": 16 }
					}
				},
				"route": {
					"type": "object",
					"additionalProperties": false,
					"required": ["animation", "animationSpeed", "color", "cornerRadius", "lineWidth"],
					"properties": {
						"animation": { "enum": ["flow", "none", "pulse"] },
						"animationSpeed": { "type": "number", "minimum": 1, "maximum": 300 },
						"color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
						"cornerRadius": { "type": "number", "minimum": 0, "maximum": 200 },
						"lineWidth": { "type": "number", "minimum": 1, "maximum": 64 }
					}
				}
			}
		},
		"requiredPolygonPresentation": {
			"type": "object",
			"additionalProperties": false,
			"required": ["extrusionHeight", "fillColor", "fillOpacity"],
			"properties": {
				"extrusionHeight": { "type": "number", "minimum": 0, "maximum": 100 },
				"fillColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
				"fillOpacity": { "type": "number", "minimum": 0, "maximum": 1 }
			}
		},
		"asset": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "name", "kind", "mimeType", "dataUrl"],
			"properties": {
				"id": { "$ref": "#/$defs/nonEmptyString" },
				"name": { "$ref": "#/$defs/nonEmptyString" },
				"kind": { "enum": ["background", "icon", "logo", "photo"] },
				"mimeType": { "$ref": "#/$defs/nonEmptyString" },
				"dataUrl": { "type": "string", "pattern": "^data:" },
				"naturalHeight": { "type": "number", "exclusiveMinimum": 0 },
				"naturalWidth": { "type": "number", "exclusiveMinimum": 0 }
			}
		},
		"polygonElement": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "floorId", "status", "provenance", "type", "geometry"],
			"properties": {
				"id": { "$ref": "#/$defs/nonEmptyString" }, "floorId": { "$ref": "#/$defs/nonEmptyString" },
				"status": { "enum": ["confirmed", "proposed"] }, "provenance": { "enum": ["ai-draft", "customer-source", "imported", "reviewer-authored"] },
				"type": { "enum": ["location", "obstacle", "walkable"] }, "geometry": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/point" } },
				"label": { "type": "string" }, "destinationId": { "$ref": "#/$defs/nonEmptyString" },
				"presentation": { "$ref": "#/$defs/polygonPresentation" }
			}
		},
		"doorElement": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "floorId", "status", "provenance", "type", "point", "angle", "length"],
			"properties": {
				"id": { "$ref": "#/$defs/nonEmptyString" }, "floorId": { "$ref": "#/$defs/nonEmptyString" },
				"status": { "enum": ["confirmed", "proposed"] }, "provenance": { "enum": ["ai-draft", "customer-source", "imported", "reviewer-authored"] },
				"type": { "const": "door" }, "point": { "$ref": "#/$defs/point" }, "angle": { "type": "number" }, "length": { "type": "number", "exclusiveMinimum": 0 },
				"locationId": { "$ref": "#/$defs/nonEmptyString" }
			}
		},
		"poiElement": {
			"type": "object", "additionalProperties": false,
			"required": ["id", "floorId", "status", "provenance", "type", "point"],
			"properties": {
				"id": { "$ref": "#/$defs/nonEmptyString" }, "floorId": { "$ref": "#/$defs/nonEmptyString" },
				"status": { "enum": ["confirmed", "proposed"] }, "provenance": { "enum": ["ai-draft", "customer-source", "imported", "reviewer-authored"] },
				"type": { "const": "poi" }, "point": { "$ref": "#/$defs/point" }, "category": { "type": "string" }, "destinationId": { "$ref": "#/$defs/nonEmptyString" }, "label": { "type": "string" }
			}
		},
		"originElement": {
			"type": "object", "additionalProperties": false,
			"required": ["id", "floorId", "status", "provenance", "type", "point", "facingDegrees", "label", "screenId"],
			"properties": {
				"id": { "$ref": "#/$defs/nonEmptyString" }, "floorId": { "$ref": "#/$defs/nonEmptyString" },
				"status": { "enum": ["confirmed", "proposed"] }, "provenance": { "enum": ["ai-draft", "customer-source", "imported", "reviewer-authored"] },
				"type": { "const": "origin" }, "point": { "$ref": "#/$defs/point" }, "defaultLanguage": { "type": "string" }, "facingDegrees": { "type": "number" }, "label": { "$ref": "#/$defs/nonEmptyString" }, "screenId": { "$ref": "#/$defs/nonEmptyString" }
			}
		},
		"transitionElement": {
			"type": "object", "additionalProperties": false,
			"required": ["id", "floorId", "status", "provenance", "type", "point", "accessible", "connectionId", "kind", "label"],
			"properties": {
				"id": { "$ref": "#/$defs/nonEmptyString" }, "floorId": { "$ref": "#/$defs/nonEmptyString" },
				"status": { "enum": ["confirmed", "proposed"] }, "provenance": { "enum": ["ai-draft", "customer-source", "imported", "reviewer-authored"] },
				"type": { "const": "transition" }, "point": { "$ref": "#/$defs/point" }, "accessible": { "type": "boolean" }, "connectionId": { "$ref": "#/$defs/nonEmptyString" }, "kind": { "enum": ["elevator", "escalator", "stairs"] }, "label": { "$ref": "#/$defs/nonEmptyString" }
			}
		},
		"labelElement": {
			"type": "object", "additionalProperties": false,
			"required": ["id", "floorId", "status", "provenance", "type", "point", "text"],
			"properties": {
				"id": { "$ref": "#/$defs/nonEmptyString" }, "floorId": { "$ref": "#/$defs/nonEmptyString" },
				"status": { "enum": ["confirmed", "proposed"] }, "provenance": { "enum": ["ai-draft", "customer-source", "imported", "reviewer-authored"] },
				"type": { "const": "label" }, "point": { "$ref": "#/$defs/point" }, "text": { "type": "string" },
				"fontFamily": { "enum": ["sans-serif", "serif", "monospace"] }, "fontSize": { "type": "number", "minimum": 6, "maximum": 512 },
				"fontWeight": { "enum": [400, 600, 700] }, "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
				"textAnchor": { "enum": ["start", "middle", "end"] }, "outlineColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
				"outlineWidth": { "type": "number", "minimum": 0, "maximum": 16 }
			}
		},
		"mediaElement": {
			"type": "object", "additionalProperties": false,
			"required": ["id", "floorId", "status", "provenance", "type", "point", "assetId", "width", "height"],
			"properties": {
				"id": { "$ref": "#/$defs/nonEmptyString" }, "floorId": { "$ref": "#/$defs/nonEmptyString" },
				"status": { "enum": ["confirmed", "proposed"] }, "provenance": { "enum": ["ai-draft", "customer-source", "imported", "reviewer-authored"] },
				"type": { "enum": ["icon", "logo"] }, "point": { "$ref": "#/$defs/point" }, "assetId": { "$ref": "#/$defs/nonEmptyString" }, "destinationId": { "$ref": "#/$defs/nonEmptyString" }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 }
			}
		},
		"floor": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "name", "order", "width", "height", "elements"],
			"properties": {
				"id": { "$ref": "#/$defs/nonEmptyString" }, "name": { "$ref": "#/$defs/nonEmptyString" }, "order": { "type": "integer" },
				"width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 },
				"backgroundAssetId": { "$ref": "#/$defs/nonEmptyString" },
				"camera3d": { "$ref": "#/$defs/camera3d" },
				"unitsPerMeter": { "type": "number", "exclusiveMinimum": 0 },
				"pedestrianSpaceSource": { "enum": ["mask", "polygons"] },
				"walkableMask": { "$ref": "wayfinding-walkable-mask.schema.json" },
				"elements": { "type": "array", "items": { "oneOf": [
					{ "$ref": "#/$defs/polygonElement" }, { "$ref": "#/$defs/doorElement" }, { "$ref": "#/$defs/poiElement" },
					{ "$ref": "#/$defs/originElement" }, { "$ref": "#/$defs/transitionElement" }, { "$ref": "#/$defs/labelElement" }, { "$ref": "#/$defs/mediaElement" }
				] } }
			}
		},
		"destination": {
			"type": "object",
			"additionalProperties": true,
			"required": ["id", "name"],
			"properties": {
				"id": { "$ref": "#/$defs/nonEmptyString" },
				"name": { "$ref": "#/$defs/nonEmptyString" },
				"accessible": { "type": "boolean" },
				"category": { "type": "string" },
				"description": { "type": "string" },
				"floor": { "type": "string" },
				"hours": { "type": "string" },
				"mapNumber": { "type": "string" },
				"phone": { "type": "string" },
				"photoAssetIds": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }, "uniqueItems": true },
				"routeable": { "type": "boolean" },
				"status": { "type": "string" },
				"translations": {
					"type": "object",
					"additionalProperties": {
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"name": { "type": "string" },
							"description": { "type": "string" }
						}
					}
				},
				"website": { "type": "string" }
			}
		}
	}
}
