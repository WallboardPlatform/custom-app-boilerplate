{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://wallboard.info/schemas/generation-brief.schema.json",
	"title": "Wallboard Custom App Generation Brief",
	"type": "object",
	"additionalProperties": false,
	"allOf": [
		{
			"if": { "properties": { "briefVersion": { "enum": [4, 5, 6] } } },
			"then": {
				"properties": { "presentation": {} },
				"required": ["presentation"]
			}
		},
		{
			"if": { "properties": { "briefVersion": { "enum": [5, 6] } } },
			"then": {
				"properties": {
					"ownership": {},
					"experience": {},
					"outputs": {},
					"rendering": {},
					"motion": {},
					"media": {},
					"branding": {}
				},
				"required": ["ownership", "experience", "outputs", "rendering", "motion", "media", "branding"]
			}
		},
		{
			"if": { "properties": { "briefVersion": { "const": 6 } } },
			"then": {
				"properties": {
					"presentation": {
						"type": "object",
						"properties": { "viewingDistance": {}, "textRoles": {} },
						"required": ["viewingDistance", "textRoles"]
					},
					"cadence": {}
				},
				"required": ["cadence"]
			}
		}
	],
	"required": [
		"briefVersion",
		"request",
		"assumptions",
		"app",
		"surfaceStrategy",
		"surfaces",
		"data",
		"settings",
		"dynamicText",
		"states",
		"behaviors",
		"assets",
		"visualDirection",
		"visualReview"
	],
	"properties": {
		"briefVersion": { "enum": [3, 4, 5, 6] },
		"request": {
			"type": "object",
			"additionalProperties": false,
			"required": ["summary", "audience", "primaryGoal"],
			"properties": {
				"summary": { "$ref": "#/$defs/nonEmptyString" },
				"audience": { "$ref": "#/$defs/nonEmptyString" },
				"primaryGoal": { "$ref": "#/$defs/nonEmptyString" }
			}
		},
		"assumptions": {
			"type": "array",
			"items": { "$ref": "#/$defs/nonEmptyString" }
		},
		"app": {
			"type": "object",
			"additionalProperties": false,
			"required": ["mode", "name", "version"],
			"properties": {
				"mode": { "enum": ["new", "replacement"] },
				"name": { "$ref": "#/$defs/nonEmptyString" },
				"version": {
					"anyOf": [
						{ "$ref": "#/$defs/nonEmptyString" },
						{ "type": "number" }
					]
				}
			}
		},
		"surfaceStrategy": {
			"type": "object",
			"additionalProperties": false,
			"required": ["mode", "rationale"],
			"properties": {
				"mode": { "enum": ["fixed", "bounded", "adaptive"] },
				"rationale": { "$ref": "#/$defs/nonEmptyString" }
			}
		},
		"surfaces": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "width", "height", "role", "purpose", "minimumContentCoverage"],
				"properties": {
					"id": { "$ref": "#/$defs/safeId" },
					"width": { "type": "integer", "minimum": 1 },
					"height": { "type": "integer", "minimum": 1 },
					"role": { "enum": ["primary", "required", "fallback"] },
					"purpose": { "$ref": "#/$defs/nonEmptyString" },
					"minimumContentCoverage": { "$ref": "#/$defs/minimumContentCoverage" }
				}
			}
		},
		"data": {
			"type": "object",
			"additionalProperties": false,
			"required": ["mode", "bindings"],
			"properties": {
				"mode": { "enum": ["static", "bound"] },
				"bindings": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["property", "source", "contract"],
						"properties": {
							"property": { "$ref": "#/$defs/nonEmptyString" },
							"source": { "enum": ["generated", "existing", "built-in"] },
							"contract": { "enum": ["TABLE", "CUSTOM", "EXISTING", "FEED", "CALENDAR"] },
							"access": { "enum": ["read", "write", "read-write"] }
						}
					}
				}
			}
		},
		"ownership": {
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/$defs/ownershipDecision" }
		},
		"experience": {
			"type": "object",
			"additionalProperties": false,
			"required": ["mode", "views", "inputs", "session"],
			"properties": {
				"mode": { "enum": ["passive", "interactive"] },
				"views": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/$defs/experienceView" }
				},
				"inputs": {
					"type": "array",
					"items": { "$ref": "#/$defs/experienceInput" }
				},
				"session": { "$ref": "#/$defs/sessionPolicy" }
			}
		},
		"outputs": {
			"type": "array",
			"items": { "$ref": "#/$defs/runtimeOutput" }
		},
		"rendering": { "$ref": "#/$defs/renderingPolicy" },
		"motion": { "$ref": "#/$defs/motionPolicy" },
		"media": {
			"type": "array",
			"items": { "$ref": "#/$defs/mediaPolicy" }
		},
		"branding": { "$ref": "#/$defs/brandingPolicy" },
		"presentation": {
			"type": "object",
			"additionalProperties": false,
			"required": ["themes", "density"],
			"properties": {
				"themes": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": { "enum": ["dark", "light", "custom"] }
				},
				"density": { "enum": ["sparse", "balanced", "dense"] },
				"viewingDistance": { "enum": ["near", "room", "distance"] },
				"textRoles": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/$defs/textRole" }
				}
			}
		},
		"cadence": { "$ref": "#/$defs/cadencePolicy" },
		"settings": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["property", "purpose"],
				"properties": {
					"property": { "$ref": "#/$defs/nonEmptyString" },
					"purpose": { "$ref": "#/$defs/nonEmptyString" },
					"effect": { "$ref": "#/$defs/safeId" }
				}
			}
		},
		"dynamicText": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "source", "selectors", "strategy", "limits", "fallback", "rationale", "evidenceScenario"],
				"properties": {
					"id": { "$ref": "#/$defs/safeId" },
					"role": { "enum": ["primary", "secondary", "metadata"] },
					"source": { "$ref": "#/$defs/dynamicTextSource" },
					"selectors": {
						"type": "array",
						"minItems": 1,
						"items": { "$ref": "#/$defs/nonEmptyString" }
					},
					"strategy": { "enum": ["auto-fit", "wrap", "ellipsis", "marquee"] },
					"limits": { "$ref": "#/$defs/dynamicTextLimits" },
					"fallback": { "$ref": "#/$defs/nonEmptyString" },
					"rationale": { "$ref": "#/$defs/nonEmptyString" },
					"evidenceScenario": { "$ref": "#/$defs/safeId" }
				}
			}
		},
		"states": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["scenario", "expectation"],
				"properties": {
					"scenario": { "$ref": "#/$defs/safeId" },
					"expectation": { "$ref": "#/$defs/nonEmptyString" }
				}
			}
		},
		"behaviors": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "expectation", "evidence"],
				"properties": {
					"id": { "$ref": "#/$defs/nonEmptyString" },
					"expectation": { "$ref": "#/$defs/nonEmptyString" },
					"evidence": {
						"oneOf": [
							{
								"type": "object",
								"additionalProperties": false,
								"required": ["scenario"],
								"properties": {
									"scenario": { "$ref": "#/$defs/safeId" }
								}
							},
							{
								"type": "object",
								"additionalProperties": false,
								"required": ["testFile"],
								"properties": {
									"testFile": { "type": "string", "pattern": "\\.spec\\.ts$" }
								}
							}
						]
					}
				}
			}
		},
		"assets": {
			"type": "array",
			"minItems": 2,
			"items": {
				"oneOf": [
					{ "$ref": "#/$defs/packagedAsset" },
					{ "$ref": "#/$defs/datasourceAsset" },
					{ "$ref": "#/$defs/settingAsset" }
				]
			}
		},
		"visualDirection": {
			"type": "object",
			"additionalProperties": false,
			"required": ["source", "summary", "references", "signatureChoices", "avoid"],
			"properties": {
				"source": { "enum": ["reference-led", "instruction-led", "creative-led", "agent-authored"] },
				"summary": { "$ref": "#/$defs/nonEmptyString" },
				"references": {
					"type": "array",
					"items": { "$ref": "#/$defs/nonEmptyString" }
				},
				"signatureChoices": {
					"type": "array",
					"minItems": 2,
					"items": { "$ref": "#/$defs/nonEmptyString" }
				},
				"avoid": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/$defs/nonEmptyString" }
				}
			}
		},
		"visualReview": {
			"type": "object",
			"additionalProperties": false,
			"required": ["intent", "focus"],
			"properties": {
				"intent": { "$ref": "#/$defs/nonEmptyString" },
				"focus": {
					"type": "array",
					"minItems": 2,
					"items": { "$ref": "#/$defs/nonEmptyString" }
				}
			}
		}
	},
	"$defs": {
		"nonEmptyString": {
			"type": "string",
			"minLength": 1,
			"pattern": "\\S"
		},
		"safeId": {
			"type": "string",
			"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
		},
		"minimumContentCoverage": {
			"type": "object",
			"additionalProperties": false,
			"required": ["width", "height"],
			"properties": {
				"width": { "type": "integer", "minimum": 1, "maximum": 100 },
				"height": { "type": "integer", "minimum": 1, "maximum": 100 }
			}
		},
		"dynamicTextSource": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "properties"],
			"properties": {
				"type": { "enum": ["setting", "datasource", "computed"] },
				"properties": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/$defs/nonEmptyString" }
				}
			}
		},
		"dynamicTextLimits": {
			"type": "object",
			"additionalProperties": false,
			"minProperties": 1,
			"properties": {
				"minimumFontSize": { "type": "integer", "minimum": 8 },
				"maximumLines": { "type": "integer", "minimum": 1 }
			}
		},
		"textRole": {
			"type": "object",
			"additionalProperties": false,
			"required": ["role", "selectors"],
			"properties": {
				"role": { "enum": ["primary", "secondary", "metadata"] },
				"selectors": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": { "$ref": "#/$defs/nonEmptyString" }
				}
			}
		},
		"cadencePolicy": {
			"type": "object",
			"additionalProperties": false,
			"required": ["mode"],
			"properties": {
				"mode": { "enum": ["static", "rotation"] },
				"intervalProperty": { "$ref": "#/$defs/nonEmptyString" }
			}
		},
		"packagedAsset": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "source", "path", "required"],
			"properties": {
				"id": { "$ref": "#/$defs/nonEmptyString" },
				"source": { "const": "packaged" },
				"path": { "$ref": "#/$defs/nonEmptyString" },
				"required": { "type": "boolean" }
			}
		},
		"datasourceAsset": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "source", "binding", "required"],
			"properties": {
				"id": { "$ref": "#/$defs/nonEmptyString" },
				"source": { "const": "datasource" },
				"binding": { "$ref": "#/$defs/nonEmptyString" },
				"required": { "type": "boolean" }
			}
		},
		"settingAsset": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "source", "properties", "required"],
			"properties": {
				"id": { "$ref": "#/$defs/nonEmptyString" },
				"source": { "const": "setting" },
				"properties": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/$defs/nonEmptyString" }
				},
				"required": { "type": "boolean" }
			}
		},
		"ownershipDecision": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "area", "owner", "targets", "rationale"],
			"properties": {
				"id": { "$ref": "#/$defs/safeId" },
				"area": { "enum": ["content", "presentation", "behavior", "state"] },
				"owner": { "enum": ["locked", "setting", "datasource", "interaction", "external-command"] },
				"targets": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": { "$ref": "#/$defs/nonEmptyString" }
				},
				"rationale": { "$ref": "#/$defs/nonEmptyString" }
			}
		},
		"experienceView": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "purpose"],
			"properties": {
				"id": { "$ref": "#/$defs/safeId" },
				"purpose": { "$ref": "#/$defs/nonEmptyString" }
			}
		},
		"experienceInput": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "type", "action"],
			"properties": {
				"id": { "$ref": "#/$defs/safeId" },
				"type": { "enum": ["touch", "pointer", "keyboard", "external-command"] },
				"action": { "$ref": "#/$defs/nonEmptyString" }
			}
		},
		"sessionPolicy": {
			"type": "object",
			"additionalProperties": false,
			"required": ["reset", "expectation"],
			"properties": {
				"reset": { "enum": ["none", "timeout", "completion", "external-command", "manual"] },
				"timeoutSeconds": { "type": "integer", "minimum": 1 },
				"expectation": { "$ref": "#/$defs/nonEmptyString" }
			}
		},
		"runtimeOutput": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "channel", "target", "operation", "editorPolicy", "expectation", "failure"],
			"properties": {
				"id": { "$ref": "#/$defs/safeId" },
				"channel": { "enum": ["internal-datasource", "sensor-event", "own-state"] },
				"target": { "$ref": "#/$defs/nonEmptyString" },
				"operation": { "enum": ["insert-to-array", "set", "merge", "increase", "decrease", "remove", "rotate", "upsert", "emit"] },
				"editorPolicy": { "enum": ["disabled", "preview-mock"] },
				"expectation": { "$ref": "#/$defs/nonEmptyString" },
				"failure": { "$ref": "#/$defs/nonEmptyString" }
			}
		},
		"renderingPolicy": {
			"type": "object",
			"additionalProperties": false,
			"required": ["mode", "letterbox", "rationale"],
			"properties": {
				"mode": { "enum": ["reflow", "fixed-canvas"] },
				"designWidth": { "type": "integer", "minimum": 1 },
				"designHeight": { "type": "integer", "minimum": 1 },
				"letterbox": { "enum": ["transparent", "background"] },
				"rationale": { "$ref": "#/$defs/nonEmptyString" }
			}
		},
		"motionPolicy": {
			"type": "object",
			"additionalProperties": false,
			"required": ["default", "techniques", "rationale"],
			"properties": {
				"default": { "enum": ["off", "subtle", "expressive"] },
				"disableProperty": { "$ref": "#/$defs/nonEmptyString" },
				"techniques": {
					"type": "array",
					"uniqueItems": true,
					"items": { "enum": ["fade", "slide", "scale", "progress", "chart", "custom"] }
				},
				"rationale": { "$ref": "#/$defs/nonEmptyString" }
			}
		},
		"mediaPolicy": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "type", "source", "fit", "fallback", "rationale"],
			"properties": {
				"id": { "$ref": "#/$defs/safeId" },
				"type": { "enum": ["image", "video"] },
				"source": { "enum": ["packaged", "datasource", "setting", "folder"] },
				"fit": { "enum": ["cover", "contain", "blur-fill", "fill"] },
				"fallback": { "$ref": "#/$defs/nonEmptyString" },
				"rationale": { "$ref": "#/$defs/nonEmptyString" }
			}
		},
		"brandingPolicy": {
			"type": "object",
			"additionalProperties": false,
			"required": ["source", "editable", "provenance", "fallback"],
			"properties": {
				"source": { "enum": ["none", "settings", "reference", "mcp-branding-kit"] },
				"editable": { "type": "boolean" },
				"provenance": { "$ref": "#/$defs/nonEmptyString" },
				"fallback": { "$ref": "#/$defs/nonEmptyString" }
			}
		}
	}
}
